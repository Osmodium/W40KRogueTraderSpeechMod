<Project Sdk="Microsoft.NET.Sdk" InitialTargets="GenerateCustomPropsFile">
    <Import Project="$(MSBuildThisFileDirectory)..\GamePath.props" Condition="Exists('$(MSBuildThisFileDirectory)..\GamePath.props')" />
    <!-- Optional, gitignored. Set VoxBridgeDll there to use a local VoxBridge build instead of the release. -->
    <Import Project="$(MSBuildThisFileDirectory)..\VoxBridge.local.props" Condition="Exists('$(MSBuildThisFileDirectory)..\VoxBridge.local.props')" />

    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <AssemblyName>W40KRTSpeechMod</AssemblyName>
        <Description>Warhammer 40K: Rogue Trader - SpeechMod</Description>
        <Version>1.3.1</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>SpeechMod</RootNamespace>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
        <RogueTraderData>$(LocalAppData)Low\Owlcat Games\Warhammer 40000 Rogue Trader</RogueTraderData>
        <AssemblyVersion>1.3.1</AssemblyVersion>
        <FileVersion>1.3.1</FileVersion>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\0Harmony.dll*" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\Code.dll*" Publicize="true" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\Kingmaker*.dll" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\LocalizationShared.dll*" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\Newtonsoft.Json.dll*" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\Owlcat*.dll" Publicize="true" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\UniRx.dll*" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\Unity.TextMeshPro.dll*" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\UnityEngine*.dll" Private="false" />
        <Reference Include="$(RogueTraderInstallDir)\WH40KRT_Data\Managed\RogueTrader*.dll" Publicize="true" Private="false" />
        <Reference Include="$(RogueTraderData)\UnityModManager\UnityModManager.dll*" Publicize="true" Private="false" />
    </ItemGroup>
    <ItemGroup>
        <None Include="Info.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
        <None Include="PhoneticDictionary.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <None Update="Localization\enGB.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- VoxBridge.dll comes from https://github.com/Osmodium/VoxBridge. The pinned release is downloaded once into .native\ and checked against its SHA256. -->
    <PropertyGroup>
        <VoxBridgeVersion>1.0.0</VoxBridgeVersion>
        <VoxBridgeSha256>D28CD4A171E268CC0F2C70BAA17BC7EE0F0B420151A3D2B1A72C85937A2FE7F3</VoxBridgeSha256>
        <VoxBridgeUrl>https://github.com/Osmodium/VoxBridge/releases/download/v$(VoxBridgeVersion)/VoxBridge.dll</VoxBridgeUrl>
        <VoxBridgeCacheDir>$(MSBuildThisFileDirectory)..\.native\VoxBridge\$(VoxBridgeVersion)\</VoxBridgeCacheDir>
        <VoxBridgeUseLocal Condition="'$(VoxBridgeDll)' != ''">true</VoxBridgeUseLocal>
        <VoxBridgeDll Condition="'$(VoxBridgeDll)' == ''">$(VoxBridgeCacheDir)VoxBridge.dll</VoxBridgeDll>
    </PropertyGroup>
    <Target Name="FetchVoxBridge" BeforeTargets="AssignTargetPaths">
        <DownloadFile Condition="'$(VoxBridgeUseLocal)' != 'true' and !Exists('$(VoxBridgeDll)')" SourceUrl="$(VoxBridgeUrl)" DestinationFolder="$(VoxBridgeCacheDir)" DestinationFileName="VoxBridge.dll" />
        <VerifyFileHash Condition="'$(VoxBridgeUseLocal)' != 'true'" File="$(VoxBridgeDll)" Hash="$(VoxBridgeSha256)" Algorithm="SHA256" />
        <Error Condition="!Exists('$(VoxBridgeDll)')" Text="VoxBridge.dll not found at '$(VoxBridgeDll)'." />
        <ItemGroup>
            <None Include="$(VoxBridgeDll)" Link="VoxBridge.dll" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <!-- Release builds zip the output into bin\W40KSpeechMod-<version>.zip. Version comes from Info.json and must match Repository.json. -->
    <PropertyGroup>
        <ModFolderName>W40KSpeechMod</ModFolderName>
        <ModVersionRegex>"Version"\s*:\s*"([^"]+)"</ModVersionRegex>
    </PropertyGroup>
    <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Info.json')), $(ModVersionRegex)).Groups[1].Value)</ModVersion>
            <RepositoryVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Repository.json')), $(ModVersionRegex)).Groups[1].Value)</RepositoryVersion>
            <ModPackageRoot>$(MSBuildProjectDirectory)\bin\package\</ModPackageRoot>
            <ModPackageZip>$(MSBuildProjectDirectory)\bin\$(ModFolderName)-$(ModVersion).zip</ModPackageZip>
        </PropertyGroup>
        <Error Condition="'$(ModVersion)' == ''" Text="Could not read Version from Info.json." />
        <Error Condition="'$(ModVersion)' != '$(RepositoryVersion)'" Text="Version mismatch: Info.json has '$(ModVersion)', Repository.json has '$(RepositoryVersion)'. Make them equal." />
        <ItemGroup>
            <_ModPackageFiles Include="$(OutDir)**\*" Exclude="$(OutDir)**\*.pdb" />
        </ItemGroup>
        <RemoveDir Directories="$(ModPackageRoot)" />
        <Copy SourceFiles="@(_ModPackageFiles)" DestinationFiles="@(_ModPackageFiles->'$(ModPackageRoot)$(ModFolderName)\%(RecursiveDir)%(Filename)%(Extension)')" />
        <ZipDirectory SourceDirectory="$(ModPackageRoot)" DestinationFile="$(ModPackageZip)" Overwrite="true" />
        <Message Importance="high" Text="Mod package: $(ModPackageZip)" />
    </Target>
    <!--<Target Name="Deploy" AfterTargets="Build">
        <ItemGroup>
            <Files Include="$(TargetDir)\**\*.*" />
        </ItemGroup>

        <Copy SourceFiles="@(Files)" DestinationFiles="@(Files->'$(RogueTraderData)\UnityModManager\$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)')" />
        <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\$(OutputPath)" DestinationFile="$(MSBuildProjectDirectory)\$(OutputPath)\..\$(AssemblyName)-$(Version).zip" Overwrite="true" />
    </Target>-->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" IncludeAssets="build; contentfiles" Version="0.4.3" PrivateAssets="all" />
        <PackageReference Include="MicroUtils.HarmonyAnalyzers" IncludeAssets="runtime; build; native; contentfiles; analyzers" Version="1.6.1" PrivateAssets="all" />
        <!--<PackageReference Include="PublishToWorkshop" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" Version="1.0.10" PrivateAssets="all" />-->
    </ItemGroup>
    <!--<Target Name="PublishToSteamWorkshop" AfterTargets="Publish">
        <RemoveDir Directories="$(OutputPath)\publish" />
        <PublishToWorkshop PathToManifest="$(MSBuildThisFileDirectory)\OwlcatModificationManifest.json" ImageDir="$(SolutionDir)" BuildDir="$(MSBuildProjectDirectory)\$(OutputPath)" PathToDescription="$(SolutionDir)Workshop-description.txt" GameAppId="2186680" />
    </Target>-->
    <Target Name="GenerateCustomPropsFile" Condition="$(RogueTraderInstallDir) == ''">
        <Exec Command="findstr /C:&quot;Mono path[0]&quot; &quot;$(RogueTraderData)\Player.log&quot;" IgnoreExitCode="true" ConsoleToMSBuild="true">
            <Output TaskParameter="ExitCode" PropertyName="ExitCode" />
            <Output TaskParameter="ConsoleOutput" PropertyName="MonoPathLine" />
        </Exec>

        <PropertyGroup>
            <MonoPathRegex>^Mono path\[0\] = '(.*?)/WH40KRT_Data/Managed'$</MonoPathRegex>
        </PropertyGroup>

        <PropertyGroup>
            <RogueTraderInstallDir>$([System.Text.RegularExpressions.Regex]::Match($(MonoPathLine), $(MonoPathRegex)).Groups[1].Value)</RogueTraderInstallDir>
        </PropertyGroup>

        <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\GamePath.props" Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;&#xD;&#xA;	&lt;PropertyGroup&gt;&#xD;&#xA;		&lt;RogueTraderInstallDir&gt;$(RogueTraderInstallDir)&lt;/RogueTraderInstallDir&gt;&#xD;&#xA;	&lt;/PropertyGroup&gt;&#xD;&#xA;&lt;/Project&gt;" Overwrite="true" Encoding="utf-8" />
    </Target>
    <Target Name="DeleteCustomPropsFile" BeforeTargets="Clean">
        <Delete Files="GamePath.props" />
    </Target>

</Project>
